# Copia este archivo como .env y completa tus datos reales.
# Nunca subir el .env al repositorio.

# Usuario y contraseña de TU esquema en Oracle (no uses ADMIN ni CINEAURORA este último reservado para producción)
DB_USUARIO=tu_usuario
DB_CONTRASENA=tu_contrasena

# Nombre de servicio del archivo tnsnames.ora del wallet (termina en _low, _medium o _high)
DB_SERVICIO=nombre_low

# Carpeta del wallet y la contraseña que se puso al descargarlo
DB_WALLET_RUTA=./wallet
DB_WALLET_CONTRASENA=contrasena_del_wallet

# Puerto del servidor Express
PUERTO=5000

# URL del cliente (Vite). Se usa para permitir el acceso desde el frontend (CORS)
CLIENT_URL=http://localhost:5173

OCI_CONFIG_PROFILE=DEFAULT
OCI_REGION=us-ashburn-1
OCI_NAMESPACE=
OCI_BUCKET=

EOF
