                    detallesPelicula.png &nbsp;&nbsp;&nbsp;
                            </td>
        </tr>
        
    


    
                        <tr>
                <td bgcolor="#f0f0f0" width="20%" valign="top"><b>Clasificación:</b></td>
                <td id="customfield_10019-10110-value" class="value" bgcolor="#ffffff" width="80%">      0|i000eg:
  </td>
            </tr>
                                <tr>
                <td bgcolor="#f0f0f0" width="20%" valign="top"><b>Sprint:</b></td>
                <td id="customfield_10020-10110-value" class="value" bgcolor="#ffffff" width="80%"></td>
